
# Copia este archivo a ".env" y reemplaza los valores. NUNCA subas ".env".
DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=usuario_de_ejemplo
DB_PASSWORD=REEMPLAZAR_LOCALMENTE

# Claves de la API (>= 12 caracteres y distintas entre sí).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY_OPERADOR=REEMPLAZAR_CLAVE_OPERADOR
API_KEY_ADMIN=REEMPLAZAR_CLAVE_ADMIN

# Control sin clave (true/false). Si es true, mover, iniciar/cancelar DEMO y
# GET /sesion se aceptan SIN X-API-Key. Crear, editar y eliminar siguen
# pidiendo la clave de operador o de administrador.
CONTROL_ABIERTO=false

# Orígenes del frontend autorizados por CORS (separados por comas, sin ruta).
CORS_ORIGINS=https://juanarmando30.github.io

# ---- Inicio de sesión (Etapa 4) ----
# Secreto para firmar los tokens de acceso y para el HMAC de tokens y códigos.
# >= 32 caracteres, distinto de las claves de arriba. Cambiarlo cierra TODAS las sesiones.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRETO=REEMPLAZAR_SECRETO_DE_TOKENS
# Minutos que dura un token de acceso y días que dura uno de renovación.
TOKEN_ACCESO_MIN=10
TOKEN_RENOVACION_DIAS=3
# Transición: lectura pública de estado/historial/DEMO (true) hasta que el
# frontend envíe tokens (Etapas 5-6). Con false exige dueño, admin o soporte.
LECTURA_ABIERTA=true
# Transición (Etapa 8): WebSocket sin ticket ni credencial, como antes. Se apaga en la Etapa 9,
# después de cargar la credencial del dispositivo en el ESP32.
WS_ABIERTO=true
