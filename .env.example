
# Copia este archivo a ".env" y reemplaza los valores. NUNCA subas ".env".
DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=usuario_de_ejemplo
DB_PASSWORD=REEMPLAZAR_LOCALMENTE

# Claves de la API (>= 12 caracteres y distintas entre sí).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY_OPERADOR=REEMPLAZAR_CLAVE_OPERADOR
API_KEY_ADMIN=REEMPLAZAR_CLAVE_ADMIN

# Control sin clave (true/false). Si es true, mover, iniciar/cancelar DEMO y
# GET /sesion se aceptan SIN X-API-Key. Crear, editar y eliminar siguen
# pidiendo la clave de operador o de administrador.
CONTROL_ABIERTO=false

# Orígenes del frontend autorizados por CORS (separados por comas, sin ruta).
CORS_ORIGINS=https://juanarmando30.github.io
